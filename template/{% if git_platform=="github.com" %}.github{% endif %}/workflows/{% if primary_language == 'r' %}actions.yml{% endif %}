name: core_actions
on:
    push:
        branches:
            - main
    pull_request:
        branches:
            - main
permissions: {}
jobs:
    build:
        runs-on: ubuntu-latest
        steps:
            - name: checkout
              uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
            - name: Setup R
              uses: r-lib/actions/setup-r@5cc1f0d89c5281319eaa97952fe65a6d55e6f816 # v2.0
            - name: Install dependencies
              uses: r-lib/actions/setup-r-dependencies@5cc1f0d89c5281319eaa97952fe65a6d55e6f816
              with:
                extra-packages: any::lintr, any::roxygen2, local::.
                needs: lint, pr-document
            - name: Document
              run: roxygen2::roxygenise()
              shell: Rscript {0}
            - name: Lint
              run: lintr::lint_package()
              shell: Rscript {0}
              env:
                LINTR_ERROR_ON_LINT: true
            - name: Check package
              uses: r-lib/actions/check-r-package@5cc1f0d89c5281319eaa97952fe65a6d55e6f816
